<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>pl.j.reinmar.mapwaw</groupId>
    <artifactId>wtp-swing-navigator</artifactId>
    <version>0.0.2-SNAPSHOT</version>

    <properties>
        <maven.compiler.source>27</maven.compiler.source>
        <maven.compiler.target>27</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <jxmapviewer2.version>2.8</jxmapviewer2.version>
        <jackson.version>2.17.2</jackson.version>
    </properties>

    <dependencies>
        <!-- 1. Biblioteka Mapowa JXMapViewer2 (OpenStreetMap w Swing) -->
        <dependency>
            <groupId>org.jxmapviewer</groupId>
            <artifactId>jxmapviewer2</artifactId>
            <version>${jxmapviewer2.version}</version>
        </dependency>

        <!-- 2. Jackson (Parsowanie JSON z API ZTM Warszawa) -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>${jackson.version}</version>
        </dependency>

        <!-- 3. SLF4J + Logback (Opcjonalny prosty logger) -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <version>2.0.13</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Wtyczka kompilatora Java 27 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <source>27</source>
                    <target>27</target>
                </configuration>
            </plugin>

            <!-- Wtyczka do szybkiego uruchamiania aplikacji z poziomu Mavena: mvn exec:java -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.3.0</version>
                <configuration>
                    <mainClass>pl.j.reinmar.mapwaw.wtp.MainApp</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>